# OpenAI API Configuration (GPT-4o mini for narrative enhancement)
OPENAI_API_KEY=your_openai_api_key_here

# Pika Labs API Configuration (Free video generation)
PIKA_API_KEY=your_pika_api_key_here
PIKA_API_URL=https://api.pika.art/v1

# ElevenLabs API Configuration (Free TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stable Diffusion Configuration (Local - no API key needed)
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
USE_LOCAL_STABLE_DIFFUSION=true

# Application Settings
MAX_SCENES_PER_MOVIE=30
IMAGE_RESOLUTION=768
VIDEO_FPS=24
FFMPEG_PATH=ffmpeg
OUTPUT_DIR=C:\Users\admin\Projects\dnd-movie-generator\output

# Processing Settings
BATCH_SIZE=5
TIMEOUT_MINUTES=120
